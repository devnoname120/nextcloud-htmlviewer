#. Warning
msgid "warning.title"
msgstr "Alerte"

#. Opening HTML files in the browser can be a security risk. Do you want to proceed?
msgid "warning.message"
msgstr "Ouvrir des fichiers HTML dans le navigateur peut être un risque pour la sécurité. Vous souhaitez continuer ?"

#. Do not warn again
msgid "warning.disable"
msgstr "Ne pas réitérer l'alerte"

#. Cancel
msgid "warning.cancel"
msgstr "Annuler"

#. Ok
msgid "warning.confirm"
msgstr "Ok"

#. Edit "{file}"
msgid "viewer.edit"
msgstr "Modifier \"{file}\""

#. The file "{file}" ({size}) exceeds the maximum allowed size of {maxSize}.
msgid "viewer.file-too-large"
msgstr "Le fichier « {file} » ({size}) dépasse la taille de fichier autorisée de {maxSize}."

#. Download
#, fuzzy
msgid "viewer.download"
msgstr "Télécharger"

#. "{file}" is saved
msgid "editor.state.saved"
msgstr "\"{file}\" est sauvegardé"

#. Saving "{file}"
msgid "editor.state.saving"
msgstr "Sauvegarde de \"{file}\""

#. Error saving "{file}"
msgid "editor.state.error"
msgstr "Erreur lors de la sauvegarde de \"{file}\""

#. Save "{file}"
msgid "editor.state.unsaved"
msgstr "Sauvegarder \"{file}\""

#. Close editor
msgid "editor.close"
msgstr "Fermer l'éditeur"

#. Save "{file}" and close editor
msgid "editor.save-and-close"
msgstr "Sauvegarder \"{file}\" et fermer l'éditeur"

#. Undo changes
msgid "editor.undo"
msgstr "Annuler les modifications"

#. Wrap long lines
#, fuzzy
msgid "editor.line-wrapping"
msgstr "Enrouler les longues cordes"

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for editing.
#, fuzzy
msgid "editor.too-large"
msgstr ""
"Le fichier « {file} » ({size}) dépasse la taille maximale autorisée de "
"{maxSize} pour la modification."

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for the code editor. Syntax highlighting and other editor features are not available.
#, fuzzy
msgid "editor.too-large-for-code-editor"
msgstr ""
"Le fichier « {file} » ({size}) dépasse la taille maximale autorisée de "
"{maxSize} pour l'éditeur de code. La coloration syntaxique et les autres "
"fonctionnalités de l'éditeur ne sont pas disponibles."

#. Close
#, fuzzy
msgid "directEditing.close"
msgstr "Fermer"

#. The file "{file}" could not be loaded.
#, fuzzy
msgid "directEditing.load-error"
msgstr "Le fichier « {file} » n'a pas pu être chargé."
