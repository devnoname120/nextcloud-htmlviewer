#. Warning
msgid "warning.title"
msgstr "Attenzione"

#. Opening HTML files in the browser can be a security risk. Do you want to proceed?
msgid "warning.message"
msgstr "L'apertura di file HTML nel browser può costituire un rischio per la sicurezza. Volete procedere?"

#. Do not warn again
msgid "warning.disable"
msgstr "Non avvertire di nuovo"

#. Cancel
msgid "warning.cancel"
msgstr "Annullamento"

#. Ok
msgid "warning.confirm"
msgstr "Ok"

#. Edit "{file}"
msgid "viewer.edit"
msgstr "Modificare \"{file}\""

#. The file "{file}" ({size}) exceeds the maximum allowed size of {maxSize}.
msgid "viewer.file-too-large"
msgstr "Il file \"{file}\" ({size}) supera la dimensione massima consentita di {maxSize}."

#. Download
#, fuzzy
msgid "viewer.download"
msgstr "Scarica"

#. "{file}" is saved
msgid "editor.state.saved"
msgstr "\"{file}\" viene salvato"

#. Saving "{file}"
msgid "editor.state.saving"
msgstr "Salvataggio di \"{file}\""

#. Error saving "{file}"
msgid "editor.state.error"
msgstr "Errore nel salvataggio di \"{file}\""

#. Save "{file}"
msgid "editor.state.unsaved"
msgstr "Salvare \"{file}\""

#. Close editor
msgid "editor.close"
msgstr "Chiudere l'editor"

#. Save "{file}" and close editor
msgid "editor.save-and-close"
msgstr "Salvare \"{file}\" e chiudere l'editor"

#. Undo changes
msgid "editor.undo"
msgstr "Annullare le modifiche"

#. Wrap long lines
#, fuzzy
msgid "editor.line-wrapping"
msgstr "Avvolgere le linee lunghe"

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for editing.
#, fuzzy
msgid "editor.too-large"
msgstr "Il file \"{file}\" ({size}) supera la dimensione massima consentita di {maxSize} per la modifica."

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for the code editor. Syntax highlighting and other editor features are not available.
#, fuzzy
msgid "editor.too-large-for-code-editor"
msgstr "Il file \"{file}\" ({size}) supera la dimensione massima di {maxSize} consentita dall'editor di codice. L'evidenziazione della sintassi e altre funzionalità dell'editor non sono disponibili."

#. Close
#, fuzzy
msgid "directEditing.close"
msgstr "Chiudi"

#. The file "{file}" could not be loaded.
#, fuzzy
msgid "directEditing.load-error"
msgstr "Impossibile caricare il file \"{file}\"."

#. HTML Viewer
#, fuzzy
msgid "admin.title"
msgstr "Visualizzatore HTML"

#. Configure how HTML files are shown and edited. Changes are saved immediately.
#, fuzzy
msgid "admin.description"
msgstr ""
"Configura le modalità di visualizzazione e modifica dei file HTML. Le "
"modifiche vengono salvate immediatamente."

#. Viewer
#, fuzzy
msgid "admin.section.viewer"
msgstr "Visualizzatore"

#. File size limits
#, fuzzy
msgid "admin.section.size"
msgstr "Limiti di dimensione dei file"

#. Content security policy and sandbox
#, fuzzy
msgid "admin.section.policy"
msgstr "Politica di sicurezza dei contenuti e sandbox"

#. The iframe which shows the HTML files is restricted by a CSP in supported browsers and a sandbox. The CSP of Nextcloud may still block content regardless of these settings. A custom policy must allow scripts for JavaScript to work.
#, fuzzy
msgid "admin.section.policy.description"
msgstr ""
"L'iframe che mostra i file HTML è soggetto a restrizioni imposte da una CSP "
"nei browser supportati e da una sandbox. La CSP di Nextcloud potrebbe "
"comunque bloccare alcuni contenuti indipendentemente da queste impostazioni. "
"Per consentire il funzionamento degli script JavaScript è necessario "
"applicare una policy personalizzata."

#. Open links in a new tab
#, fuzzy
msgid "admin.new-tab-links"
msgstr "Apri i link in una nuova scheda"

#. Allows popups in the sandbox and opens all links in a new tab. Otherwise, links can only be opened with Ctrl+click.
#, fuzzy
msgid "admin.new-tab-links.hint"
msgstr ""
"Consente la visualizzazione dei popup nella sandbox e apre tutti i link in "
"una nuova scheda. In caso contrario, i link possono essere aperti solo con "
"Ctrl+clic."

#. Allow JavaScript
#, fuzzy
msgid "admin.allow-js"
msgstr "Abilita JavaScript"

#. Not recommended: scripts in HTML files are unknown code which is executed within Nextcloud.
#, fuzzy
msgid "admin.allow-js.hint"
msgstr ""
"Sconsigliato: gli script nei file HTML sono codice sconosciuto che viene "
"eseguito all'interno di Nextcloud."

#. JavaScript is enabled. The sandbox and the CSP limit what scripts can do, but they can not guarantee that no user information is transferred to third parties.
#, fuzzy
msgid "admin.allow-js.warning"
msgstr ""
"JavaScript è abilitato. La sandbox e il CSP limitano le operazioni che gli "
"script possono eseguire, ma non possono garantire che nessuna informazione "
"dell'utente venga trasferita a terzi."

#. Direct editing in the mobile and desktop apps
#, fuzzy
msgid "admin.direct-editing"
msgstr "Modifica diretta nelle app per dispositivi mobili e desktop"

#. Offers the HTML viewer as editor for HTML files to the Android and desktop apps. Disable it to leave the direct editing of HTML files to the Text app.
#, fuzzy
msgid "admin.direct-editing.hint"
msgstr ""
"Rende disponibile il visualizzatore HTML come editor per i file HTML nelle "
"app per Android e desktop. Disattivarlo per lasciare la modifica diretta dei "
"file HTML all'app Testo."

#. Maximum file size for viewing (MB)
#, fuzzy
msgid "admin.max-size"
msgstr "Dimensione massima del file per la visualizzazione (MB)"

#. Larger files are not shown and can only be downloaded.
#, fuzzy
msgid "admin.max-size.hint"
msgstr ""
"I file di dimensioni maggiori non vengono visualizzati e possono essere solo "
"scaricati."

#. Maximum file size for editing (MB)
#, fuzzy
msgid "admin.max-editor-size"
msgstr "Dimensione massima del file per la modifica (MB)"

#. Can not exceed the maximum file size for viewing.
#, fuzzy
msgid "admin.max-editor-size.hint"
msgstr ""
"Non è possibile superare la dimensione massima del file per la "
"visualizzazione."

#. Maximum file size for the code editor (MB)
#, fuzzy
msgid "admin.max-code-editor-size"
msgstr "Dimensione massima dei file per l'editor di codice (MB)"

#. Larger files are edited in a plain text field. Can not exceed the maximum file size for editing.
#, fuzzy
msgid "admin.max-code-editor-size.hint"
msgstr ""
"I file di grandi dimensioni vengono modificati in un campo di testo "
"semplice. La dimensione del file non può superare il limite massimo "
"consentito per la modifica."

#. Content security policy
#, fuzzy
msgid "admin.csp"
msgstr "Politica sulla sicurezza dei contenuti"

#. Leave empty to use the default policy.
#, fuzzy
msgid "admin.csp.hint"
msgstr "Lasciare vuoto per utilizzare la politica predefinita."

#. Sandbox permissions
#, fuzzy
msgid "admin.sandbox"
msgstr "Autorizzazioni Sandbox"

#. Permissions separated by spaces, like "allow-forms allow-modals". Leave empty to use the default permissions.
#, fuzzy
msgid "admin.sandbox.hint"
msgstr ""
"Autorizzazioni separate da spazi, ad esempio \"allow-forms allow-modals\". "
"Lasciare vuoto per utilizzare le autorizzazioni predefinite."

#. No permissions
#, fuzzy
msgid "admin.sandbox.none"
msgstr "Nessuna autorizzazione"

#. Reset "{setting}" to default
msgid "admin.reset"
msgstr "Ripristina \"{setting}\" ai valori predefiniti"

#. Setting saved
#, fuzzy
msgid "admin.saved"
msgstr "Impostazioni salvate"

#. Setting reset to default
#, fuzzy
msgid "admin.reset-done"
msgstr "Ripristino delle impostazioni predefinite"

#. Could not save the setting
#, fuzzy
msgid "admin.save-failed"
msgstr "Impossibile salvare l'impostazione"

#. The value is not valid
#, fuzzy
msgid "admin.invalid-value"
msgstr "Il valore non è valido"

#. Enter a whole number of megabytes between 0 and {max}
#, fuzzy
msgid "admin.invalid-size"
msgstr "Inserisci un numero intero di megabyte compreso tra 0 e {max}"
