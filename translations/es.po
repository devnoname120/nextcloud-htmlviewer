msgstr "Abrir archivos HTML en el navegador puede ser un riesgo para la seguridad. ¿Desea continuar?"

#. Do not warn again
msgid "warning.disable"
msgstr "No volver a avisar"

#. Cancel
msgid "warning.cancel"
msgstr "Anular"

#. Ok
msgid "warning.confirm"
msgstr "Ok"

