#, fuzzy
msgid "admin.reset"
msgstr "Restablecer «{configuración}» a los valores predeterminados"

#. Setting saved
#, fuzzy
msgid "admin.saved"
msgstr "Configuración guardada"

#. Setting reset to default
#, fuzzy
msgid "admin.reset-done"
msgstr "Restablecimiento de la configuración a los valores predeterminados"

#. Could not save the setting
#, fuzzy
