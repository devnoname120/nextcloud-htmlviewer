#. Warning
msgid "warning.title"
msgstr "Warnung"

#. Opening HTML files in the browser can be a security risk. Do you want to proceed?
msgid "warning.message"
msgstr "HTML-Dateien im Browser zu öffnen kann ein Sicherheitsrisiko sein. Möchten Sie fortfahren?"

#. Do not warn again
msgid "warning.disable"
msgstr "Nicht erneut warnen"

#. Cancel
msgid "warning.cancel"
msgstr "Abbrechen"

#. Ok
msgid "warning.confirm"
msgstr "Ok"

#. Edit "{file}"
msgid "viewer.edit"
msgstr "\"{file}\" bearbeiten"

#. The file "{file}" ({size}) exceeds the maximum allowed size of {maxSize}.
msgid "viewer.file-too-large"
msgstr "Die Datei \"{file}\" ({size}) überschreitet die erlaubte Dateigröße von {maxSize}."

#. Download
msgid "viewer.download"
msgstr "Herunterladen"

#. "{file}" is saved
msgid "editor.state.saved"
msgstr "\"{file}\" ist gespeichert"

#. Saving "{file}"
msgid "editor.state.saving"
msgstr "\"{file}\" wird gespeichert"

#. Error saving "{file}"
msgid "editor.state.error"
msgstr "Fehler beim Speichern von \"{file}\""

#. Save "{file}"
msgid "editor.state.unsaved"
msgstr "\"{file}\" speichern"

#. Close editor
msgid "editor.close"
msgstr "Editor schließen"

#. Save "{file}" and close editor
msgid "editor.save-and-close"
msgstr "\"{file}\" speichern und Editor schließen"

#. Undo changes
msgid "editor.undo"
msgstr "Änderungen rückgängig machen"

#. Wrap long lines
msgid "editor.line-wrapping"
msgstr "Lange Zeilen umbrechen"

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for editing.
msgid "editor.too-large"
msgstr "Die Datei „{file}“ ({size}) überschreitet die maximale für die Bearbeitung zulässige Größe von {maxSize}."

#. The file "{file}" ({size}) exceeds the maximum size of {maxSize} for the code editor. Syntax highlighting and other editor features are not available.
msgid "editor.too-large-for-code-editor"
msgstr "Die Datei „{file}“ ({size}) überschreitet die maximale Größe von {maxSize} für den Code-Editor. Die Syntaxhervorhebung und andere Editorfunktionen stehen nicht zur Verfügung."

#. Close
msgid "directEditing.close"
msgstr "Schließen"

#. The file "{file}" could not be loaded.
msgid "directEditing.load-error"
msgstr "Die Datei \"{file}\" konnte nicht geladen werden."

#. HTML Viewer
msgid "admin.title"
msgstr "HTML-Betrachter"

#. Configure how HTML files are shown and edited. Changes are saved immediately.
msgid "admin.description"
msgstr ""
"Legen Sie fest, wie HTML-Dateien angezeigt und bearbeitet werden sollen."

#. Viewer
msgid "admin.section.viewer"
msgstr "Betrachter"

#. File size limits
msgid "admin.section.size"
msgstr "Dateigrößenbeschränkungen"

#. Content security policy and sandbox
msgid "admin.section.policy"
msgstr "Richtlinie zur Inhaltssicherheit (CSP) und Sandbox"

#. The iframe which shows the HTML files is restricted by a CSP in supported browsers and a sandbox. The CSP of Nextcloud may still block content regardless of these settings. A custom policy must allow scripts for JavaScript to work.
msgid "admin.section.policy.description"
msgstr ""
"Der Iframe, in dem die HTML-Dateien angezeigt werden, unterliegt in "
"unterstützten Browsern einer CSP sowie einer Sandbox. Die CSP von Nextcloud "
"kann Inhalte ungeachtet dieser Einstellungen weiterhin blockieren. Damit "
"JavaScript funktioniert, muss eine benutzerdefinierte Richtlinie dies "
"zulassen."

#. Open links in a new tab
msgid "admin.new-tab-links"
msgstr "Links in neuem Tab öffnen"

#. Allows popups in the sandbox and opens all links in a new tab. Otherwise, links can only be opened with Ctrl+click.
msgid "admin.new-tab-links.hint"
msgstr ""
"Erlaubt Popups in der Sandbox und öffnet alle Links in einem neuen Tab. "
"Andernfalls können Links nur mit Strg+Klick geöffnet werden."

#. Allow JavaScript
msgid "admin.allow-js"
msgstr "JavaScript aktivieren"

#. Not recommended: scripts in HTML files are unknown code which is executed within Nextcloud.
msgid "admin.allow-js.hint"
msgstr ""
"Warnung: Skripte in HTML-Dateien können potenziell Schadcode im Nextcloud-"
"Konto des Nutzers ausführen."

#. JavaScript is enabled. The sandbox and the CSP limit what scripts can do, but they can not guarantee that no user information is transferred to third parties.
msgid "admin.allow-js.warning"
msgstr ""
"JavaScript ist aktiviert. Sandbox und die CSP schränken die Möglichkeiten "
"von Skripten ein, können jedoch nicht garantieren, dass Dritte keinen "
"Zugriff auf Nextcloud-Daten und Nutzerkonten erhalten."

#. Direct editing in the mobile and desktop apps
msgid "admin.direct-editing"
msgstr "Direkte Bearbeitung in Apps für Mobilgeräte und Desktop-Computer"

#. Offers the HTML viewer as editor for HTML files to the Android and desktop apps. Disable it to leave the direct editing of HTML files to the Text app.
msgid "admin.direct-editing.hint"
msgstr ""
"Stellt den HTML-Betrachter als Editor für HTML-Dateien in den Android- und "
"Desktop-Apps zur Verfügung. Deaktivieren Sie diese Option, um die direkte "
"Bearbeitung von HTML-Dateien der Text-App zu überlassen."

#. Maximum file size for viewing (MB)
msgid "admin.max-size"
msgstr "Maximale Dateigröße für die Anzeige (MB)"

#. Larger files are not shown and can only be downloaded.
msgid "admin.max-size.hint"
msgstr ""
"Größere Dateien werden nicht angezeigt und können nur heruntergeladen werden."

#. Maximum file size for editing (MB)
msgid "admin.max-editor-size"
msgstr "Maximale Dateigröße für die Bearbeitung (MB)"

#. Can not exceed the maximum file size for viewing.
msgid "admin.max-editor-size.hint"
msgstr ""
"Die maximale Dateigröße für die Anzeige darf nicht überschritten werden."

#. Maximum file size for the code editor (MB)
msgid "admin.max-code-editor-size"
msgstr "Maximale Dateigröße für den erweiterten Code-Editor (MB)"

#. Larger files are edited in a plain text field. Can not exceed the maximum file size for editing.
msgid "admin.max-code-editor-size.hint"
msgstr ""
"Größere Dateien werden in einem Klartextfeld bearbeitet. Die maximale "
"Dateigröße für die Bearbeitung darf nicht überschritten werden."

#. Content security policy
msgid "admin.csp"
msgstr "Richtlinie zur Inhaltssicherheit (CSP)"

#. Leave empty to use the default policy.
msgid "admin.csp.hint"
msgstr "Lassen Sie das Feld leer, um die Standardrichtlinie zu verwenden."

#. Sandbox permissions
msgid "admin.sandbox"
msgstr "Sandbox-Berechtigungen"

#. Permissions separated by spaces, like "allow-forms allow-modals". Leave empty to use the default permissions.
msgid "admin.sandbox.hint"
msgstr ""
"Berechtigungen, durch Leerzeichen getrennt, z. B. „allow-forms allow-modals"
"“. Lassen Sie das Feld leer, um die Standardberechtigungen zu verwenden."

#. No permissions
msgid "admin.sandbox.none"
msgstr "Keine Berechtigungen"

#. Reset "{setting}" to default
msgid "admin.reset"
msgstr "„{setting}“ auf die Standardeinstellung zurücksetzen"

#. Setting saved
msgid "admin.saved"
msgstr "Erfolgreich gespeichert"

#. Setting reset to default
msgid "admin.reset-done"
msgstr "Einstellungen auf die Standardwerte zurücksetzen"

#. Could not save the setting
msgid "admin.save-failed"
msgstr "Speichern fehlgeschlagen"

#. The value is not valid
msgid "admin.invalid-value"
msgstr "Der Wert ist ungültig"

#. Enter a whole number of megabytes between 0 and {max}
msgid "admin.invalid-size"
msgstr "Geben Sie eine ganze Zahl in Megabyte zwischen 0 und {max} ein"
